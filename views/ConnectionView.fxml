<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.ConnectionController"
      spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Project 4: Database Browser" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Click Connect to enter DB URL, username and password."/>

    <HBox spacing="10">
        <Button text="Connect" onAction="#handleConnect" />
        <Label fx:id="statusLabel" text="" />
    </HBox>

</VBox>
